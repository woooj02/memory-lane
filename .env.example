# Copy to .env. Nothing here is required for the offline demo.

# The AI for translation and practice cards. Together AI is the default.
TOGETHER_API_KEY=
# TOGETHER_MODEL=moonshotai/Kimi-K3          # cards + full translation (./run.sh compare to choose)
# TOGETHER_FAST_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813 # English under live lines, as they're spoken

# Or Claude (used only if TOGETHER_API_KEY is empty, or with LLM_PROVIDER=anthropic|bedrock).
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=bedrock          # use Claude on Amazon Bedrock instead (AWS credentials from your profile)
# AWS_REGION=us-west-2
# BEDROCK_MODEL=anthropic.claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Bee: auto uses the `bee` CLI when it's installed, else the sample day.
# BEE_MODE=auto                 # cli | demo

# Who practises.
# PARENT_NAME=आमा
# PARENT_LANG=ne
# PARENT_LANG_NAME=Nepali
# BEE_HEARS=Hindi          # the language Bee's recognizer is set to (Bee has no Nepali; the AI rebuilds it)
# TZ_NAME=America/Denver
# SESSION_SIZE=6

# When deployed behind nginx, the public host name for the MCP endpoint.
# MCP_ALLOWED_HOSTS=memory-lane.91.99.162.43.sslip.io

# Background work with the real Bee.
# SYNC_MINUTES=10
# LIVE_TRANSLATE=1

# REQUIRED before real transcripts go on any public URL. Open /?token=... once.
# ACCESS_TOKEN=
